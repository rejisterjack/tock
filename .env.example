# Copy to .env before `docker compose up`. Replace the secrets before exposing the port.
# Compose overrides DATABASE_URL so the app talks to the postgres service.
# For `go run` against a database on this machine, use:
# DATABASE_URL=postgres://tock:tock@localhost:5432/tock?sslmode=disable

DATABASE_URL=postgres://tock:tock@postgres:5432/tock?sslmode=disable
TOCK_BASE_URL=http://localhost:8080
TOCK_ADMIN_PASSWORD=change-me-now
TOCK_SESSION_SECRET=change-me-session-secret
TOCK_API_TOKEN=change-me-api-token
TOCK_ADDR=:8080

# Optional. Leave the host empty to start without email.
# With `docker compose --profile smtp up`, point these at Mailpit:
# TOCK_SMTP_HOST=mailpit
# TOCK_SMTP_PORT=1025
# TOCK_SMTP_FROM=tock@localhost
TOCK_SMTP_HOST=
TOCK_SMTP_PORT=
TOCK_SMTP_USER=
TOCK_SMTP_PASSWORD=
TOCK_SMTP_FROM=

TOCK_PING_RETENTION_DAYS=90
TOCK_DEMO=false
# Set true only behind a proxy that sets X-Forwarded-For.
TOCK_TRUST_PROXY=false
